# Copier vers .env puis adapter.
POSTGRES_PASSWORD=jane_dev_password
DATABASE_URL=postgresql://jane:jane_dev_password@localhost:5433/jane?schema=public

# Keycloak (fournisseur d'identité OpenID Connect)
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=jane
KEYCLOAK_API_CLIENT_ID=jane-api
# Compte de service pour supprimer les comptes de connexion (facultatif : sans secret, seules les données de Jane sont supprimées)
KEYCLOAK_ADMIN_CLIENT_ID=jane-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=jane-admin-dev-secret
KEYCLOAK_WEB_CLIENT_ID=jane-web

# API
API_PORT=3300
WEB_ORIGIN=http://localhost:5273
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
