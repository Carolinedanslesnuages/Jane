# Copier vers .env.production sur le serveur, puis :
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
JANE_DOMAIN=jane.example.org
POSTGRES_PASSWORD=changez-moi
KEYCLOAK_ADMIN_PASSWORD=changez-moi-aussi
# Secret du compte de service Jane dans Keycloak (suppression des comptes) : longue chaîne aléatoire
JANE_ADMIN_CLIENT_SECRET=changez-moi-encore
# Nombre de jours de sauvegardes gardées (14 par défaut)
BACKUP_KEEP_DAYS=14
