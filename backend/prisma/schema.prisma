generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Utilisateur local, rattaché à un compte Keycloak par son identifiant (claim "sub").
model User {
  id              String   @id @default(uuid())
  keycloakSubject String   @unique
  email           String?
  displayName     String?
  createdAt       DateTime @default(now())
  animals         Animal[]
}

enum Sex {
  MALE
  FEMALE
}

enum Species {
  DOG
  CAT
  HORSE
  OTHER
}

/// Un animal suivi par un utilisateur.
model Animal {
  id        String    @id @default(uuid())
  ownerId   String
  name      String
  species   Species   @default(DOG)
  breed     String?
  birthDate DateTime? @db.Date
  sex       Sex?
  neutered  Boolean   @default(false)
  createdAt DateTime  @default(now())
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  observations   Observation[]
  sessions       ObservationSession[]
  activeStates   ActiveState[]
  cognitiveTests CognitiveTest[]

  @@unique([ownerId, name])
}

enum BehaviorCategory {
  EXPLORATION
  PLAY
  REST
  SOCIAL
  STRESS
  ELIMINATION
}

enum ObservationType {
  EVENT
  STATE
}

/// Un comportement observé : instantané (EVENT) ou avec une durée (STATE).
model Observation {
  id              String              @id @default(uuid())
  animalId        String
  behavior        String
  category        BehaviorCategory
  type            ObservationType
  /// Début d'un état ; vide pour un événement.
  startedAt       DateTime?
  /// Instant d'enregistrement (fin de l'état, ou moment de l'événement).
  recordedAt      DateTime            @default(now())
  durationSeconds Float?
  notes           String?
  location        String?
  weather         String?
  stimuli         String?
  animal          Animal              @relation(fields: [animalId], references: [id], onDelete: Cascade)
  /// Séance pendant laquelle l'observation a été faite, s'il y en avait une.
  sessionId       String?
  session         ObservationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([animalId, recordedAt])
  @@index([sessionId])
}

/// Un état en cours de chronométrage (démarré, pas encore arrêté).
model ActiveState {
  id        String           @id @default(uuid())
  animalId  String
  behavior  String
  category  BehaviorCategory
  startedAt DateTime         @default(now())
  animal    Animal           @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([animalId, behavior])
}

enum CognitiveTestType {
  OBJECT_PERMANENCE
  DETOUR
  MANIPULATION
}

/// Résultat d'une épreuve cognitive chronométrée.
model CognitiveTest {
  id              String            @id @default(uuid())
  animalId        String
  testType        CognitiveTestType
  recordedAt      DateTime          @default(now())
  durationSeconds Float
  /// Note de 0 à 10, facultative.
  score           Float?
  notes           String?
  animal          Animal            @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, recordedAt])
}

enum SamplingMethod {
  /// Tout ce qui se passe est noté, sans règle de sélection.
  AD_LIBITUM
  /// Un animal suivi en continu pendant la séance.
  FOCAL
  /// Relevés à intervalles réguliers.
  SCAN
}

/// Une séance d'observation : un observateur, une méthode, un début et une fin.
model ObservationSession {
  id           String         @id @default(uuid())
  animalId     String
  observerName String
  method       SamplingMethod @default(AD_LIBITUM)
  startedAt    DateTime       @default(now())
  endedAt      DateTime?
  notes        String?
  animal       Animal         @relation(fields: [animalId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@index([animalId, startedAt])
}
