generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Utilisateur local, rattaché à un compte Keycloak par son identifiant (claim "sub").
model User {
  id              String   @id @default(uuid())
  keycloakSubject String   @unique
  email           String?
  displayName     String?
  createdAt       DateTime @default(now())
  dogs            Dog[]
}

enum DogSex {
  MALE
  FEMALE
}

/// Un chien suivi par un utilisateur.
model Dog {
  id        String    @id @default(uuid())
  ownerId   String
  name      String
  breed     String?
  birthDate DateTime? @db.Date
  sex       DogSex?
  neutered  Boolean   @default(false)
  createdAt DateTime  @default(now())
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  observations Observation[]
  activeStates ActiveState[]

  @@unique([ownerId, name])
}

enum BehaviorCategory {
  EXPLORATION
  PLAY
  REST
  SOCIAL
  STRESS
  ELIMINATION
}

enum ObservationType {
  EVENT
  STATE
}

/// Un comportement observé : instantané (EVENT) ou avec une durée (STATE).
model Observation {
  id              String           @id @default(uuid())
  dogId           String
  behavior        String
  category        BehaviorCategory
  type            ObservationType
  /// Début d'un état ; vide pour un événement.
  startedAt       DateTime?
  /// Instant d'enregistrement (fin de l'état, ou moment de l'événement).
  recordedAt      DateTime         @default(now())
  durationSeconds Float?
  notes           String?
  location        String?
  weather         String?
  stimuli         String?
  dog             Dog              @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId, recordedAt])
}

/// Un état en cours de chronométrage (démarré, pas encore arrêté).
model ActiveState {
  id        String           @id @default(uuid())
  dogId     String
  behavior  String
  category  BehaviorCategory
  startedAt DateTime         @default(now())
  dog       Dog              @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@unique([dogId, behavior])
}
