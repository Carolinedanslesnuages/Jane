{
  "realm": "jane",
  "displayName": "Jane",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "clients": [
    {
      "clientId": "jane-api",
      "name": "Jane API",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "jane-web",
      "name": "Jane (application web)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://localhost:5273",
      "redirectUris": [
        "http://localhost:5273/*"
      ],
      "webOrigins": [
        "http://localhost:5273"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5273/*"
      },
      "protocolMappers": [
        {
          "name": "jane-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jane-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "jane-admin",
      "name": "Jane (compte de service)",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "jane-admin-dev-secret"
    }
  ],
  "users": [
    {
      "username": "demo@jane.test",
      "email": "demo@jane.test",
      "firstName": "Démo",
      "lastName": "Jane",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo-jane",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-jane-admin",
      "enabled": true,
      "serviceAccountClientId": "jane-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ],
  "loginTheme": "jane"
}
